{% extends "page.njk" %}

{% block main %}
    {{ super() }}
    
    <ul>
        {%- for post in collections.post -%}
        <li>
            <i><time datetime="{{ post.date.toISOString() }}">{{ post.date.toDateString() }}</time></i>
            -
            <a href="{{ post.url }}">{{ post.data.title }}</a>
        </li>
        {%- endfor -%}
    </ul>
{% endblock %}