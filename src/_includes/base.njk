<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="color-scheme" content="light dark">

    {% set tab_title %}{% block title %}{% endblock %}{% endset %}

    <meta property="og:title" content="{{ tab_title }}">
    <meta property="og:type" content="{% block og_type %}{% endblock %}">
    <meta property="og:url" content="https://www.islabre.fyi/assets/favicon.png">
    <meta property="og:image" content="https://www.islabre.fyi/favicon">

    <link rel="stylesheet" href="/assets/style.css">
    <link rel="stylesheet" href="/assets/theme.css">

    <link rel="icon" href="/assets/favicon.png">

    <title>{{ tab_title }}</title>
</head>
<body>
    <header>
        <nav>
            <a href="/">Home</a>
            |
            <a href="#menu">Menu &downarrow;</a>
        </nav>
    </header>

    <hr>

    <main>
        {% block main %}
        {% endblock %}
    </main>

    <hr>

    <footer>
        <h2>Menu navigation</h2>
        <ul id="menu">
            <li><a href="/">Home</a></li>
            <li><a href="/posts/">Posts</a></li>
            <li><a href="/projects/">Projects</a></li>
            <li><a href="/wiki/">Wiki</a></li>
        </ul>
        <small>
            <a href="https://github.com/islabre1426/islabre1426.github.io">Source code of this website</a>. <br>
            No ads. No tracking. No cookies.
        </small>
    </footer>
</body>
</html>
